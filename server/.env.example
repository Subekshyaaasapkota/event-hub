# ─────────────────────────────────────────────────────────────
# Server environment variables
# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored — never commit real secrets.
# Only MONGODB_URL, JWT_SECRET and FRONTEND_URL are required to boot.
# CLOUDINARY_CLOUD_NAME is additionally required by `npm run seed`, which points
# the demo events at generated posters hosted on your Cloudinary account.
# Run `node src/scripts/generateEventPosters.js` once to upload that artwork.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API
FRONTEND_URL=http://localhost:5173

# MongoDB
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=event_hub_portal

# Authentication — use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace_with_a_long_random_secret

# Khalti payment gateway (server-side secret; the public key is only used by Khalti's widget)
KHALTI_SECRET_KEY=

# eSewa payment gateway
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_API_URL=https://rc-epay.esewa.com.np/api/epay
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# Email (Resend) — optional. Without it, the server still boots and simply
# skips approval emails.
RESEND_API_KEY=
EMAIL_FROM=EventHub <support@example.com>

# Cloudinary image uploads — required for logos and event posters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=