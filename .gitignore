# Dependencies
node_modules/
jspm_packages/

# Environment variables — never commit real secrets
.env
.env.local
.env.*.local
!.env.example

# Build outputs
dist/
build/
client/dist/
client/build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads written locally (Cloudinary is used in production)
server/uploads/
uploads/

# Test / coverage artefacts
coverage/

# Cached Vite data
client/.vite/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor files
.vscode/
.idea/
*.sw?

# Local scratch / working notes, not part of the project
docs/your-task*

# Local account / credential scratchpad. Never committed: it is per-machine and
# is meant to hold real logins. server/.env.example documents the real vars.
Accounts.local.md
Accounts.md

# Assistant tooling installed into the repo (.opencode/skills/...). Local
# artefact of the CLI, not application code. Skills live globally too.
.opencode/
